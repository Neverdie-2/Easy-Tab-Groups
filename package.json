{
  "name": "easy-tab-groups",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only tab rescue + nested organizer for Brave / Chromium (Manifest V3). Zero network. Cannot read your pages.",
  "keywords": [
    "tabs",
    "tab-manager",
    "tab-groups",
    "browser-extension",
    "manifest-v3",
    "chromium",
    "brave",
    "privacy",
    "local-first",
    "zero-network"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Neverdie-2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neverdie-2/Easy-Tab-Groups.git"
  },
  "homepage": "https://github.com/Neverdie-2/Easy-Tab-Groups#readme",
  "bugs": {
    "url": "https://github.com/Neverdie-2/Easy-Tab-Groups/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "guard:network": "node scripts/no-network-guard.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run guard:network",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks')}catch(e){}\""
  },
  "dependencies": {
    "preact": "^10.25.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.297",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.17.0",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.5",
    "vitest": "^3.0.5"
  }
}
